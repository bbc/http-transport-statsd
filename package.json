{
  "name": "@bbc/http-transport-statsd",
  "version": "2.0.6",
  "description": "Provides stats for statsD ",
  "main": "index.js",
  "scripts": {
    "test": "jest && pnpm run lint",
    "lint": "eslint .",
    "coverage": "jest --coverage"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/test/**/*.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bbc/http-transport-statsd.git"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/bbc/http-transport-statsd/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "https",
    "http-transport",
    "stats",
    "statistics",
    "rest",
    "http",
    "statsd"
  ],
  "homepage": "https://github.com/bbc/http-transport-statsd",
  "devDependencies": {
    "@bbc/http-transport": "^4.3.0",
    "eslint": "^8.50.0",
    "eslint-config-iplayer": "^7.0.0",
    "jest": "^30.2.0",
    "nock": "^13.3.3"
  },
  "peerDependencies": {
    "@bbc/http-transport": "^3 || ^4"
  },
  "eslintConfig": {
    "extends": "iplayer",
    "env": {
      "jest": true
    },
    "parserOptions": {
      "ecmaVersion": "latest"
    }
  }
}